{
  "name": "tracs",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "author": "denimchickensoft",
  "main": "electron/main.js",
  "workspaces": [
    "client",
    "server",
    "mock-olympus",
    "packages/geo-math"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c cyan,green \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "build": "npm run build --workspace=client",
    "start": "npm run start --workspace=server",
    "electron:dev": "npm run build && electron .",
    "stage-navdata": "node electron/scripts/stage-navdata.js",
    "stage-better-sqlite3": "node electron/scripts/stage-better-sqlite3.js",
    "dist:electron": "npm run build && npm run stage-navdata && npm run stage-better-sqlite3 && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder",
    "lint": "eslint . && npm run check:tacview-core",
    "test": "vitest run",
    "knip": "knip",
    "sync:tacview-core": "node scripts/sync-tacview-core.js",
    "check:tacview-core": "node scripts/sync-tacview-core.js --check",
    "postinstall": "git config core.hooksPath .githooks || exit 0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.1",
    "@eslint/js": "^10.0.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "d3-contour": "^4.0.2",
    "electron": "^44.4.5",
    "electron-builder": "^25.0.0",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "knip": "^6.32.0",
    "polylabel": "^2.0.1",
    "shapefile": "^0.6.6",
    "stream-json": "^1.9.1",
    "tracs-geo-math": "*",
    "vitest": "^3.2.7",
    "yauzl": "^3.4.0"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.3.9",
    "express": "^4.19.2",
    "marked": "^12.0.2",
    "sql.js": "^1.12.0",
    "ws": "^8.18.0"
  },
  "build": {
    "appId": "io.github.denimchickensoft.tracs",
    "productName": "TRACS",
    "asar": false,
    "npmRebuild": false,
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/main.js",
      "electron/preload.js",
      "server/package.json",
      "server/src/**/*",
      "server/navdata/*.js",
      "server/navdata/config/**/*",
      "server/navdata/tools/extract-navdata.js",
      "server/rateConfig.example.json",
      "server/tacviewDetectionConfig.example.json",
      "docs/**/*",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "client/dist/**/*",
      "client/public/units/**/*",
      "node_modules/**/*",
      "!node_modules/electron/**",
      "!node_modules/electron-builder/**",
      "!node_modules/@electron/rebuild/**",
      "!node_modules/.bin/**",
      "!node_modules/tracs-client/**",
      "!node_modules/tracs-server/**",
      "!node_modules/tracs-mock-olympus/**",
      "!node_modules/tracs-geo-math/**",
      "!node_modules/better-sqlite3/**",
      "!node_modules/sql.js/dist/sql-asm*",
      "!node_modules/sql.js/dist/*-debug*",
      "!node_modules/sql.js/dist/sql-wasm-browser*",
      "!node_modules/sql.js/dist/worker.*",
      {
        "from": "electron/build-staging/server/navdata/cache",
        "to": "server/navdata/cache"
      },
      {
        "from": "electron/build-staging/server/data",
        "to": "server/data"
      },
      {
        "from": "electron/build-staging-node/node_modules/better-sqlite3",
        "to": "node_modules/better-sqlite3"
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "denimchickensoft",
      "repo": "TRACS",
      "releaseType": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "client/public/favicon.ico"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
