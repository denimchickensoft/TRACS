  "version": "0.1.0",
  "main": "src/index.js",
  "scripts": {
    "dev": "cross-env PORT=8721 node --watch src/index.js",
    "start": "node src/index.js",
    "extract": "node navdata/tools/extract-navdata.js",
    "build:relief": "node scripts/buildReliefMap.js",
    "build:basemap": "node scripts/buildAbmBasemap.js",
    "build:osmland": "node scripts/buildOsmLand.js",
    "build:mva": "node scripts/buildMvaMap.js",
    "package:extract": "node --experimental-sea-config navdata/tools/sea-config.json",
    "build:terrain-exe": "node scripts/terrainDataExe/build.js",
    "seed-manifest": "node scripts/terrainDataExe/seedManifest.js"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "express": "^5.2.1",
    "marked": "^18.0.14",
    "sql.js": "^1.12.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "d3-contour": "^4.0.2",
    "esbuild": "^0.21.5",
    "polylabel": "^2.0.1",
    "postject": "^1.0.0-alpha.6",
    "shapefile": "^0.6.6",
    "stream-json": "^1.9.1",
    "tracs-geo-math": "*",
    "yauzl": "^3.4.0"
  }
