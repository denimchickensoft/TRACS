{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    ".": {
      "entry": [
        "electron/preload.js"
      ]
    },
    "client": {
      "project": [
        "src/**/*.{js,jsx}"
      ]
    },
    "server": {
      "entry": [
        "scripts/*.js",
        "scripts/terrainDataExe/*.js",
        "navdata/tools/*.js"
      ],
      "project": [
        "src/**/*.js",
        "scripts/**/*.js",
        "navdata/**/*.js"
      ],
      "ignoreDependencies": [
        "esbuild",
        "postject"
      ]
    },
    "mock-olympus": {
      "project": [
        "**/*.js"
      ]
    },
    "packages/geo-math": {
      "project": [
        "**/*.js"
      ]
    },
    "relay": {
      "project": [
        "**/*.js"
      ],
      "ignoreDependencies": [
        "esbuild",
        "postject"
      ]
    }
  }
}
