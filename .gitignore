# Dependencies
node_modules/

# Reference materials - large source files not part of the project
resources/

# Claude Code local settings
.claude/

# Spec documents — local reference only
specs/

# Environment and local config
.env
.env.local

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Build output
dist/
build/

# Runtime state files (per-machine, not committed)
server/state/

# Navdata — source files (large Navigraph data) and built cache (generated at runtime)
server/navdata/source/
server/navdata/cache/

# Tile cache — downloaded at runtime, not committed
server/data/tiles/

# Backup/preview scratch data — generated locally, not committed
*.bak

# Terrain-data exe build — regenerated by build.js
server/scripts/terrainDataExe/main.bundle.js
server/scripts/terrainDataExe/main.blob
server/data/mva-preview/
server/data/relief-preview/
