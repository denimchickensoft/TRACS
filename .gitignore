# Navdata — source files (large Navigraph data) and the cache. In dev, LNM
# extraction writes Navigraph-derived files (fixes/navaids/airspace/ctrs/
# holdings/airways/msa/mora, manifest.json, sectors.json) into the same
# cache folder as the bundled theatre data, and those must never be
# committed. So everything in the cache is ignored except the bundled
# theatre files, listed by name below.
server/navdata/source/
server/navdata/cache/*
!server/navdata/cache/*/
server/navdata/cache/*/*
!server/navdata/cache/*/airports_polygons.json
!server/navdata/cache/*/basemap.json
!server/navdata/cache/*/basemap.png
!server/navdata/cache/*/geo.json
!server/navdata/cache/*/relief.json
!server/navdata/cache/*/roads.json
!server/navdata/cache/*/roads.png
!server/navdata/cache/*/terrain.json
!server/navdata/cache/*/terrain.png
!server/navdata/cache/*/water.json
!server/navdata/cache/*/water.png
!server/navdata/cache/*/mva/

# Tile cache — downloaded at runtime, not committed
server/data/tiles/

# Backup/preview scratch data — generated locally, not committed
*.bak

# Terrain-data exe build — regenerated by build.js
server/scripts/terrainDataExe/main.bundle.js
server/scripts/terrainDataExe/main.blob
server/data/mva-preview/
server/data/relief-preview/

# Throwaway missile-tracking capture diagnostic — not a real feature, never commit
server/scripts/captureWeapons.js
weapons-capture-*.jsonl
