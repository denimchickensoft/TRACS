#!/bin/sh
# Keeps the generated copies of shared files (relay/tacviewCore.js, the
# protocolVersion.js copies, relay's detection-config example) in sync:
#  - the index copies are regenerated from the *staged* sources and written
#    straight into the index, so a commit can never contain a mismatched
#    pair, even with a partial stage (git add -p);
#  - the working-tree copies are regenerated from the working-tree sources
#    and left unstaged.
# See scripts/sync-tacview-core.js. Activated repo-wide via `core.hooksPath`
# (root package.json's postinstall) rather than the default .git/hooks/,
# which isn't tracked by git and wouldn't survive a fresh clone.

node scripts/sync-tacview-core.js || exit 1
node scripts/sync-tacview-core.js --staged || exit 1
